# Copy to .env and fill in real values. `.env` is git-ignored; this file is committed.
# Every key here is validated at API boot (apps/api/src/config/env.validation.ts) — the API
# refuses to start when any is missing or malformed.

# Runtime environment: development | production | test
NODE_ENV=development

# Port the API listens on (1–65535)
PORT=3000

# PostgreSQL connection string (main database, docker-compose service `postgres` on 5432)
DATABASE_URL=postgresql://budget:budget@localhost:5432/budget?schema=public

# Access-token signing secret and lifetime (e.g. 15m, 1h)
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m

# Refresh-token signing secret and lifetime (e.g. 7d, 30d)
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRES_IN=7d

# Allowed browser origin for CORS
CORS_ORIGIN=http://localhost:5173

# --- docker-compose credentials (consumed by docker-compose.yml, not by the API) ---
# Main database
POSTGRES_USER=budget
POSTGRES_PASSWORD=budget
POSTGRES_DB=budget
# Test database (docker-compose service `postgres_test` on 5433)
POSTGRES_TEST_USER=budget
POSTGRES_TEST_PASSWORD=budget
POSTGRES_TEST_DB=budget_test
