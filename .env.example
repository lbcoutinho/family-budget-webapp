# Copy to .env and fill in real values. `.env` is git-ignored; this file is committed.
# Every key in the first section is validated at API boot (apps/api/src/config/env.validation.ts)
# — the API refuses to start when any is missing or malformed. The sections below it feed other
# tools and are checked by whatever reads them.

# Runtime environment: development | production | test
NODE_ENV=development

# Port the API listens on (1–65535)
PORT=3000

# PostgreSQL connection string (main database, docker-compose service `postgres` on 5432)
DATABASE_URL=postgresql://budget:budget@localhost:5432/budget?schema=public

# Access-token signing secret and lifetime (e.g. 15m, 1h)
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m

# Refresh-token signing secret and lifetime (e.g. 7d, 30d)
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRES_IN=7d

# Allowed browser origin for CORS
CORS_ORIGIN=http://localhost:5173

# The one account allowed to create full-system database backups
ADMIN_EMAIL=person@example.com

# --- seed credentials (consumed by apps/api/prisma/seed.ts, not by the API) ---
# The application has no sign-up screen: `pnpm --filter api db:seed` creates its only login.
# Outside production, the same command also adds sample data to that user. Placeholders only in
# this file — the real address and password belong in the git-ignored `.env`.
SEED_USER_EMAIL=person@example.com
SEED_USER_PASSWORD=change-me-as-well

# --- docker-compose credentials (consumed by docker-compose.yml, not by the API) ---
# Main database
POSTGRES_USER=budget
POSTGRES_PASSWORD=budget
POSTGRES_DB=budget
# Test database (docker-compose service `postgres_test` on 5433)
POSTGRES_TEST_USER=budget
POSTGRES_TEST_PASSWORD=budget
POSTGRES_TEST_DB=budget_test
