// Prisma schema — the single source of truth for the database. Models are added per feature as
// the milestones progress; every one of them follows the naming conventions below.
//
// Naming conventions (established by M2-T01; every later model inherits them):
//   - Models are singular PascalCase (`User`, `Transaction`), mapped to a snake_case plural table
//     with `@@map` (`users`, `transactions`). Plural because a table holds many rows, and because
//     several natural model names — `user`, `order` — are reserved words in PostgreSQL.
//   - Fields are camelCase in the schema, mapped to snake_case columns with `@map`
//     (`passwordHash` → `password_hash`). TypeScript reads as TypeScript; SQL reads as SQL.
//   - Primary keys are `id String @id @default(uuid()) @db.Uuid` — a real PostgreSQL `uuid`
//     column, not text, so it indexes and compares as a native type.
//   - Every model carries `createdAt` / `updatedAt` (`@default(now())` / `@updatedAt`).
//   - Enums are singular PascalCase with SCREAMING_SNAKE_CASE values, mapped with `@@map` too.
//   - Money is always an `Int` of cents, never `Float` or `Decimal` (ADR-0005).
//   - Every domain entity carries a `userId` (ADR-0006), so the single-user app becomes
//     multi-user without a structural migration.
//
// The client is generated as TypeScript into `src/generated/prisma` (ADR-0017): CommonJS, with
// extensionless relative imports, so the API's `module: Node16` build and the ts-jest CommonJS
// transform consume it unchanged. That output is git-ignored and regenerated by `postinstall` —
// never hand-edited, like the Orval client (ADR-0004).
//
// The connection URL is deliberately absent: Prisma 7 takes it from `prisma.config.ts` for the
// CLI, and from the driver adapter in `PrismaService` at runtime.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// The person who signs in. The application is single-user (ADR-0006): there is no sign-up
/// screen, and the one account is created by the seed (M2-T02). Only the hash of the password is
/// ever stored — argon2id, produced by the hashing service that same ticket adds.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  accounts   Account[]
  categories Category[]
  cashboxes  Cashbox[]

  @@map("users")
}

/// Where money sits: a current account, a savings account, a wallet. The first domain entity
/// (M3-T01), and the template the other master-data models follow — `userId`, `isActive`,
/// `sortOrder`.
///
/// Accounts are deactivated, not deleted, once they carry transactions (ADR-0015): `isActive`
/// keeps a retired account out of the pickers while its history stays readable.
model Account {
  id             String   @id @default(uuid()) @db.Uuid
  /// Owner. Every domain entity carries it (ADR-0006), and every query filters by it.
  userId         String   @map("user_id") @db.Uuid
  name           String
  /// Balance the account already held before the first recorded transaction, in **cents**
  /// (ADR-0005) — never a Float. May be negative, e.g. an overdrawn account.
  initialBalance Int      @default(0) @map("initial_balance")
  isActive       Boolean  @default(true) @map("is_active")
  /// Position in the user's own ordering of the list. Ties broken by `name` at query time.
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Restrict, not Cascade: deleting a user must never silently take the domain data with it.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, name])
  @@index([userId, isActive])
  @@map("accounts")
}

/// What a transaction is *for*. Income and expense are the only two sides that need classifying:
/// cashbox movements and transfers are transaction types, not categories (`CLAUDE.md`, domain
/// rules), so they never carry one.
enum CategoryKind {
  EXPENSE
  INCOME

  @@map("category_kind")
}

/// A spending or earning bucket, in a tree at most two levels deep (M3-T03): a root has
/// `parentId = NULL`, a subcategory points at a root. The depth limit is a service rule — the
/// schema cannot express "a parent must itself be a root" — and arrives with M3-T04, along with
/// the automatic "Outros" subcategory and the deactivation cascade.
///
/// Uniqueness takes two constraints, not one. `@@unique([userId, parentId, name])` covers
/// subcategories, but in PostgreSQL `NULL != NULL`, so it lets a user hold any number of roots
/// called "Alimentação". The root half is a partial unique index — `WHERE parent_id IS NULL` —
/// which Prisma's schema language cannot declare, so it is hand-written into the migration
/// (`category_root_name_unique`). Both are load-bearing; neither replaces the other.
model Category {
  id       String       @id @default(uuid()) @db.Uuid
  /// Owner. Every domain entity carries it (ADR-0006), and every query filters by it.
  userId   String       @map("user_id") @db.Uuid
  /// `NULL` on a root category. A subcategory's parent is always a root.
  parentId String?      @map("parent_id") @db.Uuid
  name     String
  kind     CategoryKind
  /// `#RRGGBB`, and set on roots only: subcategories inherit their parent's colour in the charts
  /// (`prototypes/MEMORY.md` §04). Null is a normal state, not a missing value — the palette has
  /// ten swatches and the UI falls back to a colour derived from the id.
  color    String?

  isActive  Boolean  @default(true) @map("is_active")
  /// Position in the user's own ordering, within its own level. Ties broken by `name` at query time.
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Restrict, not Cascade: deleting a user must never silently take the domain data with it.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // Restrict here too — a root with children is deleted deliberately, child rows first, never as
  // a side effect. Note the check is immediate and per row, so a single `deleteMany` spanning
  // parents and children fails with P2003: delete the subcategories in their own statement.
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children Category[] @relation("CategoryTree")

  // Subcategories only — see the note above on NULL and the partial index that covers roots.
  @@unique([userId, parentId, name])
  @@index([userId, parentId, isActive])
  @@map("categories")
}

/// Money set aside for a purpose: an emergency fund, a holiday, the next car. A cashbox is a
/// *transaction type* rather than a category (`CLAUDE.md`, domain rules) — money moves in and out
/// of it with `CASHBOX_IN` / `CASHBOX_OUT` / `CASHBOX_TRANSFER`, and none of those count as an
/// expense in the reports.
///
/// The balance is deliberately **not** a column: it is the sum of the confirmed movements, computed
/// in M4-T07. A stored total is one crash away from disagreeing with the transactions that produced
/// it. `targetAmount` is only a goal to draw progress against, and never enters any calculation.
model Cashbox {
  id           String   @id @default(uuid()) @db.Uuid
  /// Owner. Every domain entity carries it (ADR-0006), and every query filters by it.
  userId       String   @map("user_id") @db.Uuid
  name         String
  /// Free text: what this money is for. Null and empty mean the same thing to the UI.
  description  String?
  /// Optional goal, in **cents** (ADR-0005). Null means the cashbox simply accumulates.
  targetAmount Int?     @map("target_amount")
  isActive     Boolean  @default(true) @map("is_active")
  /// Position in the user's own ordering of the list. Ties broken by `name` at query time.
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Restrict, not Cascade: deleting a user must never silently take the domain data with it.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, name])
  @@index([userId, isActive])
  @@map("cashboxes")
}
