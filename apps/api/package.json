{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "Family budget REST API (NestJS + Prisma + PostgreSQL)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:cov": "vitest run src --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "openapi:export": "tsx src/openapi/export.ts",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.4",
    "@nestjs/testing": "^12.0.4",
    "@vitest/coverage-v8": "5.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.4",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.2",
    "express": "^5.2.1",
    "nestjs-pino": "^5.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
