# Copy to .env.prod, replace every placeholder, and never commit that file.
NODE_ENV=production
PORT=3000

# The password must match POSTGRES_PASSWORD below. The host is the Compose service name.
DATABASE_URL=postgresql://budget:replace-with-postgres-password@postgres:5432/budget?schema=public
POSTGRES_USER=budget
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=budget

JWT_SECRET=replace-with-an-independent-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-another-independent-random-secret
REFRESH_TOKEN_EXPIRES_IN=7d

CORS_ORIGIN=https://family-budget.localhost

# These are the same email for the current single-user deployment.
ADMIN_EMAIL=person@example.com
SEED_USER_EMAIL=person@example.com
SEED_USER_PASSWORD=replace-with-a-strong-login-password
