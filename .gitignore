# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Intermediate OpenAPI export (regenerated by `pnpm gen`; the generated client is committed, not this)
apps/api/openapi.json

# Prisma client, generated as TypeScript by `postinstall` (ADR-0017). Regenerated from
